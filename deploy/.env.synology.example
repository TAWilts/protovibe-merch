# Copy this file to /volume1/docker/protovibe-merch-multitenant-test/.env and replace every
# CHANGE_ME value before the first start.

# Published by .github/workflows/publish-image.yml. Use synology-test for a
# manually published test build, or latest for the newest versioned release.
MERCH_IMAGE_REPOSITORY=ghcr.io/tawilts/protovibe-merch-multitenant
MERCH_IMAGE_TAG=latest

SYNOLOGY_DATA_ROOT=/volume1/docker/protovibe-merch-multitenant-test/data
HOST_BIND=0.0.0.0
HOST_PORT=8090

# For a LAN-only test use the NAS address and HTTP. After configuring the DSM
# reverse proxy, use the public https URL and set COOKIE_SECURE=true.
PUBLIC_BASE_URL=http://192.168.1.10:8090
# Enables the public band-request form on the landing page. No SMTP setup is
# required; applicants receive a one-time status link instead.
PUBLIC_REGISTRATION_ENABLED=true
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUSTED_PROXIES=

ENVIRONMENT=production
DISPLAY_TIMEZONE=Europe/Berlin
MFA_ISSUER=Protovibe Merch Manager

# Generate stable, independent values, for example with:
#   openssl rand -hex 48   # SECRET_KEY
#   openssl rand -hex 32   # each database password
SECRET_KEY=replace-this-with-a-long-random-secret
DB_NAME=merch
DB_USER=merch
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DATABASE_ROOT_PASSWORD

# This account is created only if no platform account exists. Remove the
# password from .env after the first successful sign-in and container restart.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-this-with-a-long-unique-password

BACKUP_RETENTION_DAYS=90
BACKUP_CRON_FULL=0 3 * * *
BACKUP_CRON_PER_BAND=30 3 * * *

EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

UPDATE_CHECK_REPOSITORY=TAWilts/protovibe-merch
UPDATE_CHECK_TOKEN=
