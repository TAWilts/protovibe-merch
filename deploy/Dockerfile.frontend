# syntax=docker/dockerfile:1

FROM node:22-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Caddy serves the built SPA and reverse-proxies /api to the Go backend, so the
# browser sees a single origin and the session cookie stays first-party.
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv
