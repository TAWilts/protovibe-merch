# Copy this file to .env before deploying the project.
# Generate SECRET_KEY, for example with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=replace-this-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-long-unique-password
HOST_PORT=8088
BACKUP_RETENTION_DAYS=90

# Local user accounts and 2FA.  No external provider is required.  Keep
# SECRET_KEY unchanged after any user has activated 2FA, otherwise stored TOTP
# secrets cannot be decrypted.
ACCOUNT_SETUP_CODE_DAYS=14
PROFILE_REAUTH_SECONDS=600
MFA_ISSUER=Protovibe Merch Manager

# GitHub release check in the admin UI.  Leave UPDATE_CHECK_TOKEN empty for a
# public repository.  For a private repository, use a fine-grained token with
# read-only access to this single repository.
UPDATE_CHECK_REPOSITORY=TAWilts/protovibe-merch
UPDATE_CHECK_TOKEN=
UPDATE_CHECK_TIMEOUT_SECONDS=3
UPDATE_CHECK_CACHE_SECONDS=21600

# Used by docker-compose.synology.yml after switching from a local source build
# to a tested image published by GitHub Actions.  This selects which already
# published image Synology should run; it does not set the app's code version.
MERCH_IMAGE_TAG=v0.3.0
