# Copy to .env before running docker compose.
# Generate SECRET_KEY for example with:
#   openssl rand -base64 48

# --- Core ---------------------------------------------------------------
ENVIRONMENT=production
APP_VERSION=v0.0.0
PUBLIC_BASE_URL=https://merch.example.org
SITE_ADDRESS=merch.example.org
HOST_PORT=8080
HOST_TLS_PORT=8443
DISPLAY_TIMEZONE=Europe/Berlin

# --- Security -----------------------------------------------------------
# Signs sessions and encrypts stored TOTP secrets. It must stay unchanged
# once anyone has enrolled 2FA, otherwise those secrets cannot be decrypted.
SECRET_KEY=replace-this-with-a-long-random-secret
COOKIE_SECURE=true
# Comma-separated CIDRs of proxies allowed to set X-Forwarded-For.
TRUSTED_PROXIES=
ACCOUNT_SETUP_CODE_DAYS=14
PROFILE_REAUTH_SECONDS=600
MFA_ISSUER=Protovibe Merch Manager

# --- Database -----------------------------------------------------------
# Unlike the previous SQLite version there is no unlock passphrase. Protect
# the data with MariaDB TLS plus host-level volume encryption instead.
DB_NAME=merch
DB_USER=merch
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- First platform account --------------------------------------------
# Created once on first start, then this may be emptied again. The account
# must enrol 2FA on first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Backups ------------------------------------------------------------
BACKUP_RETENTION_DAYS=90
BACKUP_CRON_FULL=0 3 * * *
BACKUP_CRON_PER_BAND=30 3 * * *

# --- Optional mail ------------------------------------------------------
# Used for support-inbox notifications and support-access requests. SMTP only
# (not IMAP/POP3); many providers require a separate app password.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- GitHub release check ----------------------------------------------
UPDATE_CHECK_REPOSITORY=TAWilts/protovibe-merch
UPDATE_CHECK_TOKEN=
